  {
   "name": "03 - Inscription et confirmation email",
   "item": [
    {
     "name": "Inscription valide",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "register"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\"nom\": \"Testeur\", \"prenom\": \"Auto\", \"email\": \"{{emailTest}}\", \"password\": \"MotDePasse2026\", \"role\": \"admin\"}"
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('emailTest', 'testeur' + Date.now() + '@fitbook.test');"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Statut 201', () => pm.response.to.have.status(201));",
         "const j=pm.response.json();",
         "pm.test('Lien de confirmation fourni (dev)', () => pm.expect(j.lienConfirmationDev).to.be.a('string'));",
         "pm.collectionVariables.set('lienConfirmation', j.lienConfirmationDev);"
        ]
       }
      }
     ]
    },
