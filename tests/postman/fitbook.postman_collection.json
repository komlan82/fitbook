      "url": {
       "raw": "{{baseUrl}}/api/salles?ville=' OR '1'='1",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "salles"
       ],
       "query": [
        {
         "key": "ville",
         "value": "' OR '1'='1"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Statut 200', () => pm.response.to.have.status(200));",
         "pm.test('Aucune salle renvoyée (requête préparée)', () => pm.expect(pm.response.json().length).to.eql(0));"
        ]
       }
      }
     ]
    },
