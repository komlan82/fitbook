 "item": [
  {
   "name": "00 - Santé",
   "item": [
    {
     "name": "API et base disponibles",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/health",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "health"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Statut 200', () => pm.response.to.have.status(200));",
         "pm.test('api=ok et base=ok', () => { const j=pm.response.json(); pm.expect(j.api).to.eql('ok'); pm.expect(j.base).to.eql('ok'); });"
        ]
       }
      }
     ]
    }
   ]
  },
